plot(t, trueSignal, '-', 'LineWidth', 1.5);
hold on;
plot(t, obsSignal, 'o', 'MarkerSize', 4);
plot(t, recLinear, '--');
plot(t, recSpline, '-.');
hold off;
legend('True Signal', 'Observed Signal', 'Linear Interpolation', 'Spline Interpolation');
