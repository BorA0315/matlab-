clear; clc;

%a
rng('default');
y = 50 + 5 * randn(100, 1);

%b
y([10, 25, 40, 70, 90]) = [90; 95; 5; 100; 0];

%c
Q1 = quantile(y, 0.25);
Q3 = quantile(y, 0.75);

%d
IQR_val = Q3 - Q1;

%e
lower = Q1 - 1.5 * IQR_val;
upper = Q3 + 1.5 * IQR_val;

%f
idx_outlier = (y < lower) | (y > upper);

%g
y_clean = y(~idx_outlier);
med_clean = median(y_clean);
disp('Cleaned Median:'); disp(med_clean);
