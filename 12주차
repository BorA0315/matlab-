clear; clc; close all;

%a
[X, Y] = meshgrid(-5:0.05:5, -5:0.05:5);

%b
Z = exp(-0.08 * (X.^2 + Y.^2)) .* sin(3*X) .* cos(2*Y) + 0.15 * sin(X.*Y);

%c
figure;
surf(X, Y, Z);

%d
shading interp;
colorbar;

%e
xlabel('x-axis');
ylabel('y-axis');
zlabel('z=f(x,y)');

%f
title('Detailed Surface Plot of a Multivariable Function');

%g
grid on;
set(gca, 'FontSize', 12);

%h
view(45, 30);

%i
hold on;
Z0 = zeros(size(Z));
surf(X, Y, Z0, 'FaceAlpha', 0.4, 'EdgeColor', 'none');

%j
maxZ = max(Z, [], 'all');
minZ = min(Z, [], 'all');

%k
[maxR, maxC] = find(Z == maxZ);
maxPoint = [X(maxR, maxC), Y(maxR, maxC), maxZ];

[minR, minC] = find(Z == minZ);
minPoint = [X(minR, minC), Y(minR, minC), minZ];

%l
plot3(maxPoint(1), maxPoint(2), maxPoint(3), 'rp', 'MarkerSize', 15, 'MarkerFaceColor', 'r');
plot3(minPoint(1), minPoint(2), minPoint(3), 'bp', 'MarkerSize', 15, 'MarkerFaceColor', 'b');
legend('Surface', 'z=0 plane', 'Maximum point', 'Minimum point', 'Location', 'best');

%m
saveas(gcf, 'complex_surface.png');
