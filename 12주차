clear; clc; close all;

%a
x = [21, 22, NaN, 23, 24, 120, 25, NaN, 26, 27];

%b
idx_missing = isnan(x);

%c
mu0 = mean(x, 'omitnan');
sig0 = std(x, 'omitnan');

%d
idx_outlier = abs(x - mu0) > 3 * sig0;

%e
x_temp = x;
x_temp(idx_missing | idx_outlier) = NaN;

%f
x_clean = x_temp;
x_clean(isnan(x_temp)) = mean(x_temp, 'omitnan');

%g
mu_clean = mean(x_clean);
sig_clean = std(x_clean);

%h
figure;
plot(x, 'r--o', 'DisplayName', 'Original (x)', 'LineWidth', 1.5);
hold on;
plot(x_clean, 'b-*', 'DisplayName', 'Cleaned (x\_clean)', 'LineWidth', 1.5);
legend;
title('Sensor Data: Original vs Cleaned');
xlabel('Index'); ylabel('Value');
grid on;

saveas(gcf, 'prob1_result.png');
